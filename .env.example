# ============================================================
# UHS Clinical Desk — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# --- Database ---
# PostgreSQL connection string (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uhs_clinical_db

# --- Session ---
# A long, random string used to sign session cookies (required)
SESSION_SECRET=replace-with-a-random-64-char-string

# --- Environment ---
NODE_ENV=development

# --- Server ---
PORT=3000

# --- Cloudflare R2 (optional — for bodycam video upload) ---
# Only needed if you want bodycam multipart upload functionality
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=your-bucket-name
# R2_FORCE_PATH_STYLE=true