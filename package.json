{
  "name": "nhs-fivem-clinical-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node --check server/index.js",
    "cms:audit": "node scripts/cms-migration.js",
    "cms:migrate": "node scripts/cms-migration.js --migrate --create-draft-page",
    "cms:check": "node --check server/index.js && node --check public/cms.js && node --check public/cms2.js && node --check public/script.js && node --check scripts/cms-migration.js",
    "cms:promote": "CMS_CUTOVER_CONFIRM=YES node scripts/cms-migration.js --promote",
    "cms:retirement-check": "node scripts/cms-retirement-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  }
}
